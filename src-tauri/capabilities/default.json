{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口/迷你小窗/悬浮窗/功能弹窗/便签小窗的基础能力：核心权限 + 事件收发（悬浮球交互）+ 迷你窗与便签窗自绘标题栏（隐藏/拖动）+ 文件选择对话框（文件分析）",
  "windows": ["main", "mini", "ball", "panel-chat", "panel-analysis", "panel-schedule", "panel-voice", "note"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart",
    "core:webview:allow-create-webview-window",
    "core:window:allow-hide",
    "dialog:default"
  ]
}
