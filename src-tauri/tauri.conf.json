{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌看",
  "version": "0.16.0",
  "identifier": "com.modelquota.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix model-quota-frontend run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm --prefix model-quota-frontend run build",
    "frontendDist": "../model-quota-frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "桌看",
        "width": 1080,
        "height": 740,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/pet-models/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNTQ1NEQ0QTk4RTIwMDMKUldRRElJNnAxRlJVL3h0QkdxMlFJUkdnMkw5RkJUcEpvUUNjbDFsZVFWcUljOXM2VGVVaVF0SGcK",
      "endpoints": [
        "https://github.com/Shzyhao/quota-peek/releases/latest/download/latest.json"
      ]
    }
  }
}
