{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "看额度",
  "version": "0.1.0",
  "identifier": "com.modelquota.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix model-quota-frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix model-quota-frontend run build",
    "frontendDist": "../model-quota-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "看额度",
        "width": 1080,
        "height": 740,
        "minWidth": 860,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
